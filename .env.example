APP_DEBUG=false
DEFAULT_LANG=zh-cn

# MySQL runs on the host (or another non-Docker MySQL server).
DB_TYPE=mysql
DB_HOST=host.docker.internal
DB_NAME=lumenapi
DB_USER=lumenapi
DB_PASS=change-me
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_PREFIX=api_

# Redis is embedded in the single LumenAPI container.
REDIS_INTERNAL=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DATABASE=0

LUMEN_WEB_PORT=18080
LUMEN_SECRETS_DIR=/etc/lumenapi
